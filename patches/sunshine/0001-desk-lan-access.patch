+  // Desk supplies the access password through the child environment.
+  // Never advertise or log the secret. Stock Sunshine has no Desk environment.
+  const std::string &desk_password() {
+    static const std::string password = [] {
+      const char *value = std::getenv("DESK_ACCESS_PASSWORD");
+      std::string text = value ? value : "";
+      if (text.size() < 6 || text.size() > 64 || std::any_of(text.begin(), text.end(), [](unsigned char c) { return c < 33 || c > 126; })) {
+        return std::string {};
+      }
+      return text;
+    }();
+    return password;
+  }
+
+  const std::string &desk_id() {
+    static const std::string id = [] {
+      const char *value = std::getenv("DESK_DEVICE_ID");
+      std::string text = value ? value : "";
+      return text.size() == 9 && text.find_first_not_of("0123456789") == std::string::npos ? text : std::string {};
+    }();
+    return id;
+  }
+
+  bool desk_access_enabled() {
+    return !desk_password().empty() && !desk_id().empty();
+  }
+
+  // Bounded global limiter, including failed and abandoned handshakes.
+  bool desk_allow_attempt() {
+    static std::mutex mutex;
+    static std::deque<std::chrono::steady_clock::time_point> attempts;
+    std::scoped_lock lock {mutex};
+    const auto now = std::chrono::steady_clock::now();
+    while (!attempts.empty() && now - attempts.front() >= 1min) {
+      attempts.pop_front();
+    }
+    if (attempts.size() >= 30) {
+      return false;
+    }
+    attempts.push_back(now);
+    return true;
+  }
 
