+/** @file src/desk_clipboard.h
+ * @brief Authenticated loopback bridge to the current desktop user's clipboard helper.
+ */
+#ifndef DESK_CLIPBOARD_H
+#define DESK_CLIPBOARD_H
+#include <curl/curl.h>
+#include <nlohmann/json.hpp>
+#include <cstdlib>
+#include <string>
+namespace desk_clipboard {
+/** @brief Forward only supported clipboard operations to the private helper. */
+inline nlohmann::json forward(const std::string &peer,nlohmann::json request) {
+  const char *port_env=std::getenv("DESK_CLIPBOARD_PORT"), *token_env=std::getenv("DESK_CLIPBOARD_TOKEN");
+  if (!port_env || !token_env) return {{"ok",false},{"error","Host clipboard integration is unavailable"}};
+  const std::string port(port_env),token(token_env),op=request.value("op",std::string());
+  if (port.empty() || port.size()>5 || port.find_first_not_of("0123456789")!=std::string::npos || token.size()!=72) return {{"ok",false},{"error","Invalid bridge configuration"}};
+  if (op!="open" && op!="exchange" && op!="read" && op!="close" && op!="capabilities") return {{"ok",false},{"error","Unsupported operation"}};
+  request["peer"]=peer;
+  auto body=request.dump(); std::string response;
+  auto curl=curl_easy_init(); if (!curl) return {{"ok",false},{"error","Bridge unavailable"}};
+  auto headers=curl_slist_append(nullptr,("Authorization: Bearer "+token).c_str());
+  headers=curl_slist_append(headers,"Content-Type: application/json");
+  const auto url="http://127.0.0.1:"+port+"/";
+  curl_easy_setopt(curl,CURLOPT_URL,url.c_str());curl_easy_setopt(curl,CURLOPT_PROXY,"");
+  curl_easy_setopt(curl,CURLOPT_HTTPHEADER,headers);curl_easy_setopt(curl,CURLOPT_POSTFIELDS,body.c_str());
+  curl_easy_setopt(curl,CURLOPT_POSTFIELDSIZE,long(body.size()));curl_easy_setopt(curl,CURLOPT_TIMEOUT_MS,3000L);curl_easy_setopt(curl,CURLOPT_CONNECTTIMEOUT_MS,1000L);curl_easy_setopt(curl,CURLOPT_NOSIGNAL,1L);
+  curl_easy_setopt(curl,CURLOPT_WRITEDATA,&response);
+  curl_easy_setopt(curl,CURLOPT_WRITEFUNCTION,+[](char *data,size_t size,size_t count,void *ctx)->size_t {
+    auto &out=*static_cast<std::string*>(ctx);if (count>1024*1024 || size>1024*1024 || size*count>1024*1024-out.size()) return 0;
+    out.append(data,size*count);return size*count;
+  });
+  const auto result=curl_easy_perform(curl);curl_slist_free_all(headers);curl_easy_cleanup(curl);
+  if (result!=CURLE_OK) return {{"ok",false},{"error","Clipboard helper unavailable"}};
+  return nlohmann::json::parse(response);
+}
+}
+#endif
