+++ b/src/desk_lifecycle.h
@@ -0,0 +1,65 @@
+/**
+ * @file src/desk_lifecycle.h
+ * @brief Bounded lifetime for the Sunshine process owned by Desk.
+ */
+#ifndef DESK_LIFECYCLE_H
+#define DESK_LIFECYCLE_H
+#include <cerrno>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <thread>
+#include <utility>
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace desk_lifecycle {
+  /**
+   * @brief Watch the private stdin pipe held open by Desk, even if Desk crashes.
+   *
+   * Unmanaged Sunshine instances keep their existing service lifetime. Closing
+   * the pipe requests graceful shutdown, with an independent five-second limit
+   * in case a worker or the shutdown callback is stuck. No PID lookup is needed.
+   * @param stop Callback requesting ordinary host shutdown.
+   */
+  inline void watch_parent(std::function<void()> stop) {
+    const char *managed = std::getenv("DESK_MANAGED_HOST");
+    if (!managed || std::strcmp(managed, "1") != 0) {
+      return;
+    }
+    std::thread([stop = std::move(stop)]() {
+      // Buffered stdio can hold stdin's FILE lock while blocked, preventing
+      // normal process exit from completing its stdio cleanup.
+      char buffer[64];
+#ifdef _WIN32
+      DWORD count;
+      while (ReadFile(GetStdHandle(STD_INPUT_HANDLE), buffer, sizeof(buffer), &count, nullptr) && count != 0) {
+      }
+#else
+      for (;;) {
+        const auto count = ::read(STDIN_FILENO, buffer, sizeof(buffer));
+        if (count > 0 || (count < 0 && errno == EINTR)) {
+          continue;
+        }
+        break;
+      }
+#endif
+      std::thread([]() {
+        std::this_thread::sleep_for(std::chrono::seconds(5));
+        std::_Exit(EXIT_SUCCESS);
+      }).detach();
+      stop();
+    }).detach();
+  }
+}
+#endif
